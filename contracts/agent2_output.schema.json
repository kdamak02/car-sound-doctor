{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent2_output.schema.json",
  "title": "Agent 2 output: ranked causes and physical checks",
  "description": "Pass 1 proposes causes and checks. Pass 2 (round >= 2) re-ranks the causes with the user's answers.",
  "type": "object",
  "required": ["pass", "causes", "checks", "conclusive"],
  "properties": {
    "pass": {"type": "integer", "minimum": 1, "maximum": 3},
    "causes": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": {
        "type": "object", "required": ["name", "prob", "evidence"],
        "properties": {
          "name": {"type": "string"},
          "label": {"type": ["string", "null"], "description": "matching id from labels.json, if any"},
          "prob": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {"type": "array", "items": {"type": "string"}, "description": "audio result, user text, check answers, passages"}
        }
      }
    },
    "checks": {
      "type": "array", "maxItems": 5,
      "description": "Empty when conclusive is true.",
      "items": {"$ref": "#/$defs/check"}
    },
    "conclusive": {"type": "boolean"},
    "message_to_user": {"type": "string", "description": "Short text sent on Telegram with the checks."},
    "safety_stop": {"type": "boolean", "description": "true if the car must not be driven (brakes, steering, overheating)."}
  },
  "$defs": {
    "check": {
      "type": "object", "required": ["id", "q", "why", "citation"],
      "properties": {
        "id": {"type": "string", "pattern": "^c[0-9]+$"},
        "q": {"type": "string", "description": "a question the user can answer without tools"},
        "why": {"type": "string"},
        "answer_type": {"enum": ["yes_no", "choice", "free_text"]},
        "choices": {"type": "array", "items": {"type": "string"}},
        "citation": {"$ref": "citation.schema.json"}
      }
    }
  }
}
