ey&quot;"},{"text_raw":"First plug out and it's pretty gnarly. The center electrode is pretty much burned up. That means performance loss and bad fuel mileage etc.","bullet":"black","level":0,"lineid":null,"text_rendered":"First plug out and it's pretty gnarly. The center electrode is pretty much burned up. That means performance loss and bad fuel mileage etc."},{"text_raw":"Spark plug face looks good. No oil or soot, engine burns pretty clean.","bullet":"black","level":0,"lineid":null,"text_rendered":"Spark plug face looks good. No oil or soot, engine burns pretty clean."}],"guideid":107723,"stepid":206658,"orderby":3,"revisionid":2882626,"pending_patrol":{"gsr":null,"gst":null},"media":{"type":"image","data":[{"id":1440662,"guid":"6bogAZEPHmJeSUdX","mini":"https:\/\/guide-images.cdn.ifixit.com\/igi\/6bogAZEPHmJeSUdX.mini","thumbnail":"https:\/\/guide-images.cdn.ifixit.com\/igi\/6bogAZEPHmJeSUdX.thumbnail","140x105":"https:\/\/guide-images.cdn.ifixit.com\/igi\/6bogAZEPHmJeSUdX.140x105","200x150":"https:\/\/guide-images.cdn.ifixit.com\/igi\/6bogAZEPHmJeSUdX.200x150","standard":"https:\/\/guide-images.cdn.ifixit.com\/igi\/6bogAZEPHmJeSUdX.standard","440x330":"https:\/\/guide-images.cdn.ifixit.com\/igi\/6bogAZEPHmJeSUdX.440x330","medium":"https:\/\/guide-images.cdn.ifixit.com\/igi\/6bogAZEPHmJeSUdX.medium","large":"https:\/\/guide-images.cdn.ifixit.com\/igi\/6bogAZEPHmJeSUdX.large","huge":"https:\/\/guide-images.cdn.ifixit.com\/igi\/6bogAZEPHmJeSUdX.huge","original":"https:\/\/guide-images.cdn.ifixit.com\/igi\/6bogAZEPHmJeSUdX.full"},{"id":1440664,"guid":"N5QhuQy1nmJlrciY","mini":"https:\/\/guide-images.cdn.ifixit.com\/igi\/N5QhuQy1nmJlrciY.mini","thumbnail":"https:\/\/guide-images.cdn.ifixit.com\/igi\/N5QhuQy1nmJlrciY.thumbnail","140x105":"https:\/\/guide-images.cdn.ifixit.com\/igi\/N5QhuQy1nmJlrciY.140x105","200x150":"https:\/\/guide-images.cdn.ifixit.com\/igi\/N5QhuQy1nmJlrciY.200x150","standard":"https:\/\/guide-images.cdn.ifixit.com\/igi\/N5QhuQy1nmJlrciY.standar