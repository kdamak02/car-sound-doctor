n.ifixit.com\/static\/images\/avatars\/User\/ifixit\/avatar-5.440x330","medium":"https:\/\/assets.cdn.ifixit.com\/static\/images\/avatars\/User\/ifixit\/avatar-5.medium","large":"https:\/\/assets.cdn.ifixit.com\/static\/images\/avatars\/User\/ifixit\/avatar-5.large"},"reputation":1,"url":"https:\/\/www.ifixit.com\/User\/4263395\/sidneibenedito84","teams":[]},"title":"How to Disconnect a Car or Truck Battery","text_raw":"Tradu\u00e7\u00e3o em portugu\u00eas","text_rendered":"<p>Tradu\u00e7\u00e3o em portugu\u00eas<\/p>","rating":0,"date":1675779673,"modified_date":0,"status":"public","replies":[]}]},{"title":"","lines":[{"text_raw":"At this point, depending on the vehicle, your hood may raise and support itself automatically.","bullet":"icon_note","level":0,"lineid":null,"text_rendered":"At this point, depending on the vehicle, your hood may raise and support itself automatically."},{"text_raw":"If not, use one hand to hold the hood open temporarily while securing the hood with the prop rod:","bullet":"black","level":0,"lineid":null,"text_rendered":"If not, use one hand to hold the hood open temporarily while securing the hood with the prop rod:"},{"text_raw":"Lift one end of the prop rod up or out to release it from the front area of the engine bay.","bullet":"black","level":1,"lineid":null,"text_rendered":"Lift one end of the prop rod up or out to release it from the front area of the engine bay."},{"text_raw":"Swing the end of the prop rod up and slide it into the cutout on the underside of the hood.","bullet":"black","level":1,"lineid":null,"text_rendered":"Swing the end of the prop rod up and slide it into the cutout on the underside of the hood."},{"text_raw":"Make sure the hood is well secured before you let go with your other hand, or it may fall and injure you.","bullet":"icon_caution","level":1,"lineid":null,"text_rendered":"Make sure the hood is well secured before you let go with your other hand, or it may fall and injure you."}],"guideid":66802,"stepid":