# Copy to .env and fill in. Never commit .env.

# Telegram bot (create it with @BotFather)
TELEGRAM_BOT_TOKEN=

# LLM provider keys (use the one the team chose)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Speech to text (Whisper) if used through an API
WHISPER_API_KEY=

# Data downloads
KAGGLE_API_TOKEN=

# Services (defaults work with docker compose)
MOCK_MODE=true
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=car_manuals
AUDIO_SERVICE_URL=http://audio-service:8001
RAG_SERVICE_URL=http://rag-service:8002

# n8n
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
GENERIC_TIMEZONE=Africa/Tunis

# Agent 1 real mode (needs models/agent1_ast.joblib and agent1_ae.pt)
AGENT1_REAL=false
AGENT1_MOCK=true
